{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PocketPlan",
  "version": "0.1.4",
  "identifier": "com.folio.budget",
  "build": {
    "beforeDevCommand": "npm run dev:native",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:native",
    "frontendDist": "../dist-native",
    "additionalWatchFolders": [
      "../crates/pocketplan-core/src"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PocketPlan",
        "zoomHotkeysEnabled": false,
        "width": 1440,
        "height": 960,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
